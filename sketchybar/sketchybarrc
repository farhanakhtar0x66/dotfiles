#!/usr/bin/env bash

# config directory
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sketchybar"
export CONFIG_DIR
source "$CONFIG_DIR/colors.sh"

# Bar geometry
# Bar geometry: sticky — full width, flush with the screen edge, no rounding.
# 38pt is taller than the 13" MacBook Air notch strip (37.5pt), so it hides the notch;
# notch_width keeps items clear of the camera cutout. Translucent over a blur.
sketchybar --bar \
  position=top \
  height=38 \
  y_offset=0 \
  margin=0 \
  corner_radius=0 \
  color="$BAR_COLOR" \
  border_width=0 \
  blur_radius=20 \
  shadow=off \
  sticky=on \
  padding_left=10 \
  padding_right=10 \
  notch_width=208

# Shared item defaults
sketchybar --default \
  background.height=30 \
  background.color="$SURFACE_COLOR" \
  background.corner_radius=10 \
  background.padding_left=4 \
  background.padding_right=4 \
  icon.padding_left=10 \
  icon.padding_right=10 \
  icon.background.height=30 \
  icon.background.corner_radius=10 \
  label.padding_left=10 \
  label.padding_right=10 \
  icon.font="$FONT_DISPLAY" \
  label.font="$FONT_TEXT"

# Load items in their left-to-right order
ITEMS=(
  workspaces
  front_app
  media
  network
  ram
  cpu
  volume
  battery
  clock
)

for item in "${ITEMS[@]}"; do
  source "$CONFIG_DIR/items/$item.sh"
done

# Refresh immediately after all items are registered
# Now-playing listener (event-driven, no polling). Restarted on every reload via a pid file.
PIDFILE="${TMPDIR:-/tmp}/sketchybar.media_stream.pid"
if [ -r "$PIDFILE" ]; then
  pkill -P "$(<"$PIDFILE")" 2>/dev/null
  kill "$(<"$PIDFILE")" 2>/dev/null
fi
nohup "$CONFIG_DIR/helpers/media_stream.sh" >/dev/null 2>&1 &
echo $! > "$PIDFILE"

sketchybar --update
