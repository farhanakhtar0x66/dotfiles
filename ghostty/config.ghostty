# Font
font-family = "JetBrainsMono Nerd Font"
font-style = "Bold"
font-size = 14

# Theme
theme = "GitHub Dark"
foreground = #ffffff

# Cursor
cursor-style = block

# Window Padding
window-padding-x = 8
window-padding-y = 8

# Mouse
mouse-hide-while-typing = true

# Scrollbar
scrollbar = never

# Transparency
background-opacity = 0.85

# macOS background blur
background-blur-radius = 20
